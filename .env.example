# --- backend selector ---
# smtp | resend  (auto: resend if RESEND_API_KEY is set, else smtp)
MAILER_BACKEND=

# --- shared ---
# Where send_email defaults its `to` field when the caller omits it.
MAIL_DEFAULT_TO=you@gmail.com

# --- Resend backend (HTTPS, works on cloud hosts that block SMTP) ---
RESEND_API_KEY=
# For testing without verifying a domain, use the Resend sandbox sender.
# Note: sandbox sender can ONLY deliver to the Resend account-owner's email.
# To send to anyone, verify a domain at https://resend.com/domains and replace.
RESEND_FROM=JobSearcherBot <onboarding@resend.dev>

# --- SMTP backend (Gmail by default) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM_NAME=JobSearcherBot
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- server ---
PORT=8090
MCP_PATH=/mcp
